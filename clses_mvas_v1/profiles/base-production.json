    {"id": "need-demonstrated", "domain": "outcome_realization", "objective": "Credible evidence demonstrates the beneficiary problem or opportunity", "evidence_types": ["need_evidence"], "authority_role": "outcome_authority", "max_age_seconds": 7776000},
    {"id": "stakeholders-represented", "domain": "outcome_realization", "objective": "Affected beneficiaries and potentially harmed groups are represented", "evidence_types": ["stakeholder_evidence"], "authority_role": "outcome_authority", "max_age_seconds": 7776000},
    {"id": "alternatives-assessed", "domain": "outcome_realization", "objective": "Software, non-software, procurement, and no-action alternatives are compared", "evidence_types": ["alternatives_analysis"], "authority_role": "outcome_authority", "max_age_seconds": 7776000},
    {"id": "intervention-justified", "domain": "outcome_realization", "objective": "The causal or contribution logic connecting software to outcomes is credible", "evidence_types": ["intervention_analysis"], "authority_role": "outcome_authority", "max_age_seconds": 7776000},
    {"id": "outcomes-measurable", "domain": "outcome_realization", "objective": "Outcomes have baselines, targets, populations, measures, and horizons", "evidence_types": ["measurement_design"], "authority_role": "outcome_authority", "max_age_seconds": 7776000},
    {"id": "benefit-risk-acceptable", "domain": "outcome_realization", "objective": "Observed benefits justify residual risks and unintended harms", "evidence_types": ["benefit_risk_evaluation"], "authority_role": "outcome_authority", "max_age_seconds": 2592000},
    {"id": "economic-case-current", "domain": "outcome_realization", "objective": "Observed lifecycle cost remains proportionate to realized value", "evidence_types": ["economic_evaluation"], "authority_role": "outcome_authority", "max_age_seconds": 2592000},
    {"id": "ethical-impact-acceptable", "domain": "outcome_realization", "objective": "Distributional effects, exclusion, misuse, and harms remain acceptable", "evidence_types": ["ethical_impact_evaluation"], "authority_role": "outcome_authority", "max_age_seconds": 2592000},
    {"id": "realized-benefit-observed", "domain": "outcome_realization", "objective": "Target beneficiary outcomes are achieved and sustained", "evidence_types": ["outcome_observation"], "authority_role": "outcome_authority", "max_age_seconds": 2592000},
    {"id": "continuation-justified", "domain": "outcome_realization", "objective": "Continuation, correction, restriction, expansion, suspension, or retirement is evidence-bound", "evidence_types": ["continuation_evaluation"], "authority_role": "outcome_authority", "max_age_seconds": 2592000},
    {"id": "authority-separated", "domain": "governance", "objective": "Execution and consequential authority are separated", "evidence_types": ["authorization_audit"], "authority_role": "governance_authority", "max_age_seconds": 2592000},
    {"id": "requirements-verifiable", "domain": "requirements", "objective": "Requirements are traceable and objectively verifiable", "evidence_types": ["requirements_analysis"], "authority_role": "product_authority", "max_age_seconds": 2592000},
    {"id": "architecture-fit", "domain": "architecture", "objective": "Architecture addresses quality attributes and operating constraints", "evidence_types": ["architecture_assessment"], "authority_role": "architecture_authority", "max_age_seconds": 2592000},
    {"id": "implementation-reproducible", "domain": "implementation", "objective": "Source and build are reproducible and bound to the declared design", "evidence_types": ["build_provenance"], "authority_role": "engineering_authority", "max_age_seconds": 604800},
    {"id": "verification-effective", "domain": "verification", "objective": "Required behavior and quality attributes pass independent evaluation", "evidence_types": ["test_result"], "authority_role": "quality_authority", "max_age_seconds": 604800},
    {"id": "security-privacy-acceptable", "domain": "security_privacy", "objective": "Security and privacy risks satisfy declared policy", "evidence_types": ["security_assessment", "privacy_assessment"], "authority_role": "security_authority", "max_age_seconds": 604800},
    {"id": "supply-chain-trusted", "domain": "supply_chain", "objective": "Dependencies, provenance, licenses, and vulnerabilities satisfy policy", "evidence_types": ["supply_chain_assessment"], "authority_role": "security_authority", "max_age_seconds": 604800},
    {"id": "release-accepted", "domain": "release", "objective": "The exact artifact is accepted and authorized for its environment", "evidence_types": ["release_evidence"], "authority_role": "release_authority", "max_age_seconds": 604800},
    {"id": "deployment-current", "domain": "deployment", "objective": "Current deployed bytes and configuration equal the authorized release", "evidence_types": ["deployment_inventory"], "authority_role": "release_authority", "max_age_seconds": 86400},
    {"id": "operations-effective", "domain": "operations", "objective": "Service objectives, telemetry, and support controls are effective", "evidence_types": ["operational_observation"], "authority_role": "operations_authority", "max_age_seconds": 86400},
    {"id": "incidents-controlled", "domain": "incident_response", "objective": "Incidents are detectable, actionable, and governed", "evidence_types": ["incident_readiness"], "authority_role": "operations_authority", "max_age_seconds": 604800},
    {"id": "recovery-demonstrated", "domain": "resilience", "objective": "Rollback, restore, continuity, and recovery objectives are demonstrated", "evidence_types": ["recovery_exercise"], "authority_role": "resilience_authority", "max_age_seconds": 2592000},
    {"id": "change-reassessed", "domain": "change", "objective": "Material changes trigger impact analysis and reassessment", "evidence_types": ["change_monitor"], "authority_role": "governance_authority", "max_age_seconds": 86400},
    {"id": "retirement-ready", "domain": "retirement", "objective": "Decommissioning, migration, retention, and disposal are governed", "evidence_types": ["retirement_plan"], "authority_role": "governance_authority", "max_age_seconds": 2592000}
  ]
}

{
  "format": "CLSES-software-quality-profile/v1",
  "profile_id": "software-quality",
  "version": "1.0.0",
  "extends": [],
  "system_classes": ["general"],
  "dimensions": [
    {"id": "functional_suitability", "objective": "The system provides complete, correct functions that satisfy declared needs."},
    {"id": "performance_efficiency", "objective": "The system meets declared timing, capacity, and resource expectations under stated load."},
    {"id": "compatibility", "objective": "The system coexists and exchanges information correctly across declared boundaries."},
    {"id": "interaction_capability", "objective": "Intended users can learn, operate, understand, and access the system effectively."},
    {"id": "reliability", "objective": "The system remains available, fault tolerant, and recoverable for declared conditions."},
    {"id": "security", "objective": "The system preserves confidentiality, integrity, authenticity, accountability, and resistance."},
    {"id": "maintainability", "objective": "The system can be analyzed, tested, modified, and evolved with controlled effort and risk."},
    {"id": "flexibility", "objective": "The system can adapt, scale, install, and replace dependencies under declared change scenarios."},
    {"id": "safety", "objective": "The system controls hazards and reaches safe states when unsafe operation is possible."}
  ],
  "criteria": [
    {"id": "quality-functional-completeness", "dimension": "functional_suitability", "objective": "All accepted functional requirements have verified behavior.", "metric": "functional_requirement_coverage", "unit": "ratio", "operator": ">=", "evidence_type": "functional_coverage_test", "authority_role": "quality_authority", "max_age_seconds": 604800, "applicability": "always", "context_tags": [], "change_triggers": ["requirement", "interface", "workflow"]},
    {"id": "quality-functional-correctness", "dimension": "functional_suitability", "objective": "Observed incorrect results remain within the explicitly accepted limit.", "metric": "incorrect_result_rate", "unit": "ratio", "operator": "<=", "evidence_type": "correctness_test", "authority_role": "quality_authority", "max_age_seconds": 604800, "applicability": "always", "context_tags": [], "change_triggers": ["requirement", "algorithm", "data_model"]},
    {"id": "quality-response-time", "dimension": "performance_efficiency", "objective": "Representative response time satisfies the declared percentile target under declared load.", "metric": "p95_response_time", "unit": "milliseconds", "operator": "<=", "evidence_type": "performance_test", "authority_role": "quality_authority", "max_age_seconds": 604800, "applicability": "always", "context_tags": [], "change_triggers": ["runtime", "dependency", "load", "infrastructure"]},
    {"id": "quality-capacity", "dimension": "performance_efficiency", "objective": "Sustained capacity satisfies the declared workload and headroom target.", "metric": "supported_operations_per_second", "unit": "operations_per_second", "operator": ">=", "evidence_type": "capacity_test", "authority_role": "operations_authority", "max_age_seconds": 604800, "applicability": "contextual", "context_tags": ["high_load", "scalable"], "change_triggers": ["load", "infrastructure", "architecture"]},
    {"id": "quality-interface-conformance", "dimension": "compatibility", "objective": "Declared interfaces conform to their versioned contracts.", "metric": "interface_conformance", "unit": "ratio", "operator": ">=", "evidence_type": "contract_test", "authority_role": "quality_authority", "max_age_seconds": 604800, "applicability": "always", "context_tags": [], "change_triggers": ["interface", "dependency", "protocol"]},
    {"id": "quality-coexistence", "dimension": "compatibility", "objective": "Resource and configuration interference remains within the accepted limit.", "metric": "coexistence_interference_rate", "unit": "ratio", "operator": "<=", "evidence_type": "coexistence_test", "authority_role": "operations_authority", "max_age_seconds": 604800, "applicability": "contextual", "context_tags": ["shared_environment", "multi_tenant"], "change_triggers": ["infrastructure", "tenant_model", "resource_policy"]},
    {"id": "quality-operability", "dimension": "interaction_capability", "objective": "Representative users complete critical tasks successfully.", "metric": "critical_task_success_rate", "unit": "ratio", "operator": ">=", "evidence_type": "usability_test", "authority_role": "product_authority", "max_age_seconds": 2592000, "applicability": "always", "context_tags": [], "change_triggers": ["workflow", "user_interface", "user_population"]},
    {"id": "quality-accessibility", "dimension": "interaction_capability", "objective": "The user interface meets the declared accessibility conformance target.", "metric": "accessibility_conformance", "unit": "ratio", "operator": ">=", "evidence_type": "accessibility_assessment", "authority_role": "product_authority", "max_age_seconds": 2592000, "applicability": "contextual", "context_tags": ["user_interface", "public_facing"], "change_triggers": ["user_interface", "content", "user_population"]},
    {"id": "quality-availability", "dimension": "reliability", "objective": "Observed service availability satisfies the declared service objective.", "metric": "availability", "unit": "ratio", "operator": ">=", "evidence_type": "reliability_observation", "authority_role": "operations_authority", "max_age_seconds": 86400, "applicability": "always", "context_tags": [], "change_triggers": ["runtime", "deployment", "infrastructure", "dependency"]},
    {"id": "quality-recoverability", "dimension": "reliability", "objective": "Recovery completes within the declared recovery-time objective without unacceptable loss.", "metric": "recovery_time", "unit": "seconds", "operator": "<=", "evidence_type": "recovery_quality_test", "authority_role": "resilience_authority", "max_age_seconds": 2592000, "applicability": "contextual", "context_tags": ["persistent_state", "critical_service"], "change_triggers": ["storage", "backup", "deployment", "architecture"]},
    {"id": "quality-integrity", "dimension": "security", "objective": "Security-relevant integrity violations remain within the explicitly accepted limit.", "metric": "integrity_violation_count", "unit": "count", "operator": "<=", "evidence_type": "integrity_security_test", "authority_role": "security_authority", "max_age_seconds": 604800, "applicability": "always", "context_tags": [], "change_triggers": ["code", "dependency", "identity", "data_flow"]},
    {"id": "quality-confidentiality", "dimension": "security", "objective": "Confidentiality violations remain within the explicitly accepted limit.", "metric": "confidentiality_violation_count", "unit": "count", "operator": "<=", "evidence_type": "confidentiality_assessment", "authority_role": "security_authority", "max_age_seconds": 604800, "applicability": "contextual", "context_tags": ["personal_data", "confidential_data", "regulated_data"], "change_triggers": ["data_classification", "data_flow", "identity", "dependency"]},
    {"id": "quality-analyzability", "dimension": "maintainability", "objective": "Diagnostic evidence identifies the cause of representative failures.", "metric": "diagnostic_coverage", "unit": "ratio", "operator": ">=", "evidence_type": "diagnostic_assessment", "authority_role": "engineering_authority", "max_age_seconds": 2592000, "applicability": "always", "context_tags": [], "change_triggers": ["architecture", "observability", "runtime"]},
    {"id": "quality-testability", "dimension": "maintainability", "objective": "Automated verification covers the accepted change and regression surface.", "metric": "automated_test_pass_rate", "unit": "ratio", "operator": ">=", "evidence_type": "testability_assessment", "authority_role": "quality_authority", "max_age_seconds": 604800, "applicability": "always", "context_tags": [], "change_triggers": ["code", "requirement", "architecture", "test_strategy"]},
    {"id": "quality-adaptability", "dimension": "flexibility", "objective": "The system works across the declared supported environments.", "metric": "supported_environment_coverage", "unit": "ratio", "operator": ">=", "evidence_type": "portability_test", "authority_role": "engineering_authority", "max_age_seconds": 2592000, "applicability": "always", "context_tags": [], "change_triggers": ["runtime", "platform", "operating_condition"]},
    {"id": "quality-replaceability", "dimension": "flexibility", "objective": "A declared replaceable dependency can be substituted without violating its contract.", "metric": "replacement_conformance", "unit": "ratio", "operator": ">=", "evidence_type": "replaceability_test", "authority_role": "architecture_authority", "max_age_seconds": 2592000, "applicability": "contextual", "context_tags": ["external_dependency", "replaceable_adapter"], "change_triggers": ["dependency", "adapter", "architecture"]},
    {"id": "quality-fail-safe", "dimension": "safety", "objective": "Unsafe failure scenarios reach a declared safe state.", "metric": "unsafe_failure_count", "unit": "count", "operator": "<=", "evidence_type": "fail_safe_test", "authority_role": "safety_authority", "max_age_seconds": 604800, "applicability": "contextual", "context_tags": ["safety_relevant"], "change_triggers": ["hazard", "control_logic", "operating_condition"]},
    {"id": "quality-hazard-control", "dimension": "safety", "objective": "No identified unacceptable hazard remains without verified control.", "metric": "unmitigated_hazard_count", "unit": "count", "operator": "<=", "evidence_type": "hazard_analysis", "authority_role": "safety_authority", "max_age_seconds": 2592000, "applicability": "contextual", "context_tags": ["safety_relevant"], "change_triggers": ["hazard", "architecture", "operating_condition", "user_population"]}
  ],
  "tradeoff_policy": {
    "required_fields": ["id", "criterion_ids", "decision", "rationale", "authority", "decided_at", "review_by"],
    "rule": "Any accepted degradation, exclusion, or conflict between applicable criteria requires a named human authority, rationale, affected criteria, and review date."
  },
  "threshold_policy": "Every applicable criterion requires an explicit system-specific threshold from the criterion authority; the profile supplies no consequential threshold defaults."
}

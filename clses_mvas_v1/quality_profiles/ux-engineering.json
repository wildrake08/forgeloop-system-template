{
  "format": "CLSES-software-quality-profile/v1",
  "profile_id": "ux-engineering",
  "version": "1.0.0",
  "extends": ["software-quality"],
  "system_classes": ["interactive-software"],
  "dimensions": [
    {"id": "ux_research_grounding", "objective": "UX decisions are grounded in representative users, needs, tasks, and operating contexts."},
    {"id": "ux_task_effectiveness", "objective": "Intended users complete critical journeys correctly and without avoidable failure."},
    {"id": "ux_efficiency_and_cognitive_load", "objective": "Critical journeys require acceptable time, effort, attention, and memory."},
    {"id": "ux_learnability", "objective": "New and returning users can reach competent use within declared expectations."},
    {"id": "ux_error_tolerance_and_recovery", "objective": "The interaction prevents avoidable errors and supports successful recovery."},
    {"id": "ux_information_architecture", "objective": "Users can find, understand, and navigate to needed information and actions."},
    {"id": "ux_trust_transparency_and_control", "objective": "Users understand consequential behavior and retain meaningful control."},
    {"id": "ux_satisfaction_and_continuity", "objective": "The experience is acceptable to intended users and avoids preventable journey abandonment."},
    {"id": "ux_inclusion_and_contextual_fit", "objective": "Critical journeys work for declared abilities, languages, devices, and environments."},
    {"id": "ux_ethical_and_ai_interaction", "objective": "Interactions avoid manipulation and govern AI-mediated decisions with comprehension and recourse."}
  ],
  "criteria": [
    {"id": "ux-user-research-coverage", "dimension": "ux_research_grounding", "objective": "Validated research covers the declared critical user segments.", "metric": "critical_user_segment_research_coverage", "unit": "ratio", "operator": ">=", "evidence_type": "user_research_assessment", "authority_role": "ux_authority", "max_age_seconds": 7776000, "applicability": "always", "context_tags": [], "change_triggers": ["user_population", "market", "workflow", "operating_condition"]},
    {"id": "ux-context-validation", "dimension": "ux_research_grounding", "objective": "Research and evaluation cover the declared material operating contexts.", "metric": "material_operating_context_coverage", "unit": "ratio", "operator": ">=", "evidence_type": "contextual_inquiry_assessment", "authority_role": "ux_authority", "max_age_seconds": 7776000, "applicability": "always", "context_tags": [], "change_triggers": ["operating_condition", "device", "location", "workflow"]},
    {"id": "ux-critical-journey-success", "dimension": "ux_task_effectiveness", "objective": "Representative users successfully complete declared critical journeys.", "metric": "critical_journey_success_rate", "unit": "ratio", "operator": ">=", "evidence_type": "moderated_usability_test", "authority_role": "product_authority", "max_age_seconds": 2592000, "applicability": "always", "context_tags": [], "change_triggers": ["workflow", "user_interface", "requirement", "user_population"]},
    {"id": "ux-error-free-completion", "dimension": "ux_task_effectiveness", "objective": "Critical journeys complete without assistance or material user error.", "metric": "error_free_critical_journey_rate", "unit": "ratio", "operator": ">=", "evidence_type": "task_effectiveness_test", "authority_role": "ux_authority", "max_age_seconds": 2592000, "applicability": "always", "context_tags": [], "change_triggers": ["workflow", "user_interface", "content", "user_population"]},
    {"id": "ux-time-on-task", "dimension": "ux_efficiency_and_cognitive_load", "objective": "Representative completion time for critical journeys remains within the accepted limit.", "metric": "critical_journey_completion_time", "unit": "seconds", "operator": "<=", "evidence_type": "task_efficiency_test", "authority_role": "product_authority", "max_age_seconds": 2592000, "applicability": "always", "context_tags": [], "change_triggers": ["workflow", "user_interface", "performance", "device"]},
    {"id": "ux-cognitive-load", "dimension": "ux_efficiency_and_cognitive_load", "objective": "Reported cognitive load for critical journeys remains within the accepted instrument score.", "metric": "critical_journey_cognitive_load_score", "unit": "instrument_score", "operator": "<=", "evidence_type": "cognitive_walkthrough_assessment", "authority_role": "ux_authority", "max_age_seconds": 2592000, "applicability": "always", "context_tags": [], "change_triggers": ["workflow", "user_interface", "content", "information_architecture"]},
    {"id": "ux-first-use-success", "dimension": "ux_learnability", "objective": "Representative first-time users complete the declared onboarding journey.", "metric": "first_use_journey_success_rate", "unit": "ratio", "operator": ">=", "evidence_type": "learnability_test", "authority_role": "ux_authority", "max_age_seconds": 2592000, "applicability": "always", "context_tags": [], "change_triggers": ["onboarding", "workflow", "user_interface", "user_population"]},
    {"id": "ux-time-to-proficiency", "dimension": "ux_learnability", "objective": "Intended users reach declared proficient performance within the accepted time.", "metric": "time_to_declared_proficiency", "unit": "minutes", "operator": "<=", "evidence_type": "proficiency_study", "authority_role": "product_authority", "max_age_seconds": 7776000, "applicability": "contextual", "context_tags": ["frequent_use", "professional_user", "training_required"], "change_triggers": ["workflow", "training", "user_population", "role_model"]},
    {"id": "ux-preventable-error-rate", "dimension": "ux_error_tolerance_and_recovery", "objective": "Preventable user errors in critical journeys remain within the accepted limit.", "metric": "preventable_user_error_rate", "unit": "ratio", "operator": "<=", "evidence_type": "error_analysis", "authority_role": "ux_authority", "max_age_seconds": 2592000, "applicability": "always", "context_tags": [], "change_triggers": ["workflow", "user_interface", "validation", "content"]},
    {"id": "ux-error-recovery-success", "dimension": "ux_error_tolerance_and_recovery", "objective": "Representative users recover successfully from declared material error states.", "metric": "material_error_recovery_success_rate", "unit": "ratio", "operator": ">=", "evidence_type": "error_recovery_test", "authority_role": "quality_authority", "max_age_seconds": 2592000, "applicability": "always", "context_tags": [], "change_triggers": ["error_handling", "workflow", "user_interface", "failure_mode"]},
    {"id": "ux-findability", "dimension": "ux_information_architecture", "objective": "Representative users locate critical information and actions successfully.", "metric": "critical_item_findability_rate", "unit": "ratio", "operator": ">=", "evidence_type": "findability_test", "authority_role": "ux_authority", "max_age_seconds": 2592000, "applicability": "always", "context_tags": [], "change_triggers": ["information_architecture", "navigation", "content", "feature_set"]},
    {"id": "ux-navigation-dead-ends", "dimension": "ux_information_architecture", "objective": "Critical journeys contain no unaccepted navigation dead ends.", "metric": "critical_navigation_dead_end_count", "unit": "count", "operator": "<=", "evidence_type": "journey_inspection", "authority_role": "ux_authority", "max_age_seconds": 604800, "applicability": "always", "context_tags": [], "change_triggers": ["information_architecture", "navigation", "workflow", "routing"]},
    {"id": "ux-critical-decision-comprehension", "dimension": "ux_trust_transparency_and_control", "objective": "Representative users correctly understand consequential choices before acting.", "metric": "consequential_choice_comprehension_rate", "unit": "ratio", "operator": ">=", "evidence_type": "comprehension_test", "authority_role": "product_authority", "max_age_seconds": 2592000, "applicability": "always", "context_tags": [], "change_triggers": ["content", "policy", "workflow", "risk"]},
    {"id": "ux-user-control-coverage", "dimension": "ux_trust_transparency_and_control", "objective": "Declared consequential user actions provide the required confirmation, cancellation, reversal, or recourse.", "metric": "consequential_action_control_coverage", "unit": "ratio", "operator": ">=", "evidence_type": "user_control_assessment", "authority_role": "product_authority", "max_age_seconds": 604800, "applicability": "always", "context_tags": [], "change_triggers": ["workflow", "authorization", "policy", "data_lifecycle"]},
    {"id": "ux-satisfaction", "dimension": "ux_satisfaction_and_continuity", "objective": "Post-task satisfaction meets the declared score using the named instrument.", "metric": "post_task_satisfaction_score", "unit": "instrument_score", "operator": ">=", "evidence_type": "satisfaction_study", "authority_role": "product_authority", "max_age_seconds": 2592000, "applicability": "always", "context_tags": [], "change_triggers": ["workflow", "user_interface", "performance", "user_population"]},
    {"id": "ux-journey-abandonment", "dimension": "ux_satisfaction_and_continuity", "objective": "Preventable abandonment of critical journeys remains within the accepted limit.", "metric": "critical_journey_abandonment_rate", "unit": "ratio", "operator": "<=", "evidence_type": "experience_analytics", "authority_role": "product_authority", "max_age_seconds": 604800, "applicability": "contextual", "context_tags": ["production_users", "instrumented_experience"], "change_triggers": ["workflow", "user_interface", "performance", "operating_condition"]},
    {"id": "ux-assistive-technology-success", "dimension": "ux_inclusion_and_contextual_fit", "objective": "Users of declared assistive technologies complete critical journeys successfully.", "metric": "assistive_technology_critical_journey_success_rate", "unit": "ratio", "operator": ">=", "evidence_type": "assistive_technology_test", "authority_role": "accessibility_authority", "max_age_seconds": 2592000, "applicability": "contextual", "context_tags": ["user_interface", "public_facing", "accessibility_required"], "change_triggers": ["user_interface", "content", "platform", "user_population"]},
    {"id": "ux-localized-journey-success", "dimension": "ux_inclusion_and_contextual_fit", "objective": "Representative users complete critical journeys in every declared supported locale.", "metric": "supported_locale_critical_journey_coverage", "unit": "ratio", "operator": ">=", "evidence_type": "localization_usability_test", "authority_role": "localization_authority", "max_age_seconds": 2592000, "applicability": "contextual", "context_tags": ["localized", "multilingual"], "change_triggers": ["locale", "content", "workflow", "user_population"]},
    {"id": "ux-deceptive-patterns", "dimension": "ux_ethical_and_ai_interaction", "objective": "No unaccepted deceptive or coercive interaction pattern is present.", "metric": "unaccepted_deceptive_pattern_count", "unit": "count", "operator": "<=", "evidence_type": "ethical_interaction_review", "authority_role": "ethics_authority", "max_age_seconds": 2592000, "applicability": "always", "context_tags": [], "change_triggers": ["user_interface", "content", "business_model", "consent", "policy"]},
    {"id": "ux-ai-decision-understanding", "dimension": "ux_ethical_and_ai_interaction", "objective": "Affected users understand the role, material limits, and consequences of AI-mediated behavior.", "metric": "ai_mediation_comprehension_rate", "unit": "ratio", "operator": ">=", "evidence_type": "ai_interaction_comprehension_test", "authority_role": "ai_governance_authority", "max_age_seconds": 2592000, "applicability": "contextual", "context_tags": ["ai_mediated", "automated_decision"], "change_triggers": ["model", "prompt", "explanation", "policy", "user_population"]},
    {"id": "ux-ai-recourse-success", "dimension": "ux_ethical_and_ai_interaction", "objective": "Affected users can exercise declared correction, override, escalation, or appeal paths.", "metric": "ai_recourse_path_success_rate", "unit": "ratio", "operator": ">=", "evidence_type": "ai_recourse_test", "authority_role": "ai_governance_authority", "max_age_seconds": 2592000, "applicability": "contextual", "context_tags": ["ai_mediated", "automated_decision"], "change_triggers": ["model", "workflow", "authorization", "appeal_policy"]}
  ],
  "tradeoff_policy": {
    "required_fields": ["id", "criterion_ids", "decision", "rationale", "authority", "decided_at", "review_by"],
    "rule": "UX trade-offs must preserve applicable safety, accessibility, consent, and authority constraints; every accepted degradation or conflict requires a named human authority, rationale, affected criteria, and review date."
  },
  "threshold_policy": "Every applicable UX criterion requires an explicit system-, population-, journey-, context-, and instrument-specific threshold from its human authority; the profile supplies no consequential threshold defaults."
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/clses/v3/adapter-manifest.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["format", "id", "version", "digest", "capabilities", "trust_anchor", "execution_boundary", "command", "timeout_seconds"],
  "properties": {
    "format": {"const": "CLSES-adapter-manifest/v1"}, "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "capabilities": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "trust_anchor": {"type": "string", "minLength": 1}, "execution_boundary": {"enum": ["isolated", "external_service", "read_only"]},
    "command": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}
  }
}

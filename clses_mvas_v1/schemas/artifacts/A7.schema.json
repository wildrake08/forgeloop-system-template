{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/clses/v0.3.1/A7.schema.json",
  "title": "A7 Payload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "method_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version"
      ]
    },
    "measurements": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      },
      "minProperties": 1
    },
    "measurement_units": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "minProperties": 1
    },
    "observed_at": {
      "type": "integer"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_provenance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "kind": {
      "enum": [
        "test",
        "runtime",
        "execution",
        "deployment"
      ]
    }
  },
  "required": [
    "target_ref",
    "method_ref",
    "measurements",
    "measurement_units",
    "observed_at",
    "source_ids",
    "coverage",
    "source_provenance",
    "kind"
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/clses/v4.2/authorization-request-packet.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "packet_id", "required_principal", "created_at", "status", "items", "deferred_to_other_principals", "authority_notice", "packet_digest"],
  "properties": {
    "format": {"const": "CLSES-authorization-request-packet/v1"},
    "packet_id": {"type": "string", "minLength": 1},
    "required_principal": {"enum": ["owner", "engineering-reviewer", "release-owner"]},
    "created_at": {"type": "integer", "minimum": 0},
    "status": {"const": "awaiting_explicit_decisions"},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["decision_id", "scope", "summary", "evidence", "approve_exactly", "reject_exactly"],
        "properties": {
          "decision_id": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "evidence": {"type": "object"},
          "approve_exactly": {"type": "string", "pattern": "^APPROVE "},
          "reject_exactly": {"type": "string", "pattern": "^REJECT "}
        }
      }
    },
    "deferred_to_other_principals": {"type": "array", "items": {"type": "object"}},
    "authority_notice": {"type": "string", "minLength": 1},
    "packet_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}

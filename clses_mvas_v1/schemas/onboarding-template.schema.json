{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://example.org/clses/v4.5/onboarding-template.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["format", "id", "version", "title", "description", "profile", "starter_facts", "inputs"],
  "properties": {
    "format": {"const": "CLSES-onboarding-template/v1"}, "id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}, "profile": {"type": "string", "minLength": 1},
    "starter_facts": {"type": "object"},
    "inputs": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["fact_id", "label", "help", "value_type", "required"], "properties": {"fact_id": {"type": "string", "minLength": 1}, "label": {"type": "string", "minLength": 1}, "help": {"type": "string", "minLength": 1}, "value_type": {"enum": ["string", "number", "string_list", "object"]}, "required": {"type": "boolean"}}}}
  }
}

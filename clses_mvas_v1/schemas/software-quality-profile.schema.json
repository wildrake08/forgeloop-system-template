{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/clses/v4.5/software-quality-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "profile_id", "version", "extends", "system_classes", "dimensions", "criteria", "tradeoff_policy", "threshold_policy"],
  "properties": {
    "format": {"const": "CLSES-software-quality-profile/v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "extends": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "system_classes": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true},
    "dimensions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "objective"], "properties": {"id": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1}}}},
    "criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
    "tradeoff_policy": {"type": "object", "additionalProperties": false, "required": ["required_fields", "rule"], "properties": {"required_fields": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}, "rule": {"type": "string", "minLength": 1}}},
    "threshold_policy": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "criterion": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "dimension", "objective", "metric", "unit", "operator", "evidence_type", "authority_role", "max_age_seconds", "applicability", "context_tags", "change_triggers"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "dimension": {"type": "string", "minLength": 1}, "objective": {"type": "string", "minLength": 1},
        "metric": {"type": "string", "minLength": 1}, "unit": {"type": "string", "minLength": 1}, "operator": {"enum": [">=", ">", "<=", "<", "=="]},
        "evidence_type": {"type": "string", "minLength": 1}, "authority_role": {"type": "string", "minLength": 1}, "max_age_seconds": {"type": "integer", "minimum": 1},
        "applicability": {"enum": ["always", "contextual"]}, "context_tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "change_triggers": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
      }
    }
  }
}
